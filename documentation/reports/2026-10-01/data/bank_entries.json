"weight": ">1, to be learned"
},
"note": "`value` = weeks before each eligible season's peak that count as approaching-peak (guardrail [2, 12], default 6); `weight` = lambda in [1.0, 5.0]. Lambda is the peak-rectification experiment's sweep variable.\n"
},
"rank": 5,
"loss": "L = 1/N sum w_i l(yhat_i, y_i); w_i = lambda if approaching-peak else 1"
